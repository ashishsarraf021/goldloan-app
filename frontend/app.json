{
  "expo": {
    "name": "Gold Loan Tracker",
    "slug": "ashish-sarraf",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#B8860B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldloan.tracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.goldloan.tracker"
    },
    "extra": {
          "apiUrl": "https://goldloan-app.onrender.com/api/v1",
          "eas": {
            "projectId": "b9a0844a-f5fa-4e3a-9ca0-4588ddba8c44"
          }
        },
        "plugins": ["expo-secure-store"],
        "owner": "ashishsarraf021"
  }
}
