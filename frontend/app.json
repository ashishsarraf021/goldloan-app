{
  "expo": {
    "name": "Gold Loan Tracker",
    "slug": "goldloan-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#B8860B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldloan.tracker"
    },
    "android": {
      "package": "com.goldloan.tracker"
    },
    "extra": {
      "apiUrl": "http://localhost:8080/api/v1"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
