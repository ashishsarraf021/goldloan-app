# Server
PORT=8080
GIN_MODE=debug

# Database (use sqlite for local dev, postgres for production)
DB_DRIVER=sqlite
DATABASE_URL=./data/goldloan.db
# For PostgreSQL:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/goldloan?sslmode=disable

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRY_HOURS=72

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# Interest reminder schedule (cron: every day at 9 AM checks 6-month reminders)
REMINDER_CRON=0 9 * * *

# Default shop settings
DEFAULT_GOLD_RATE_PER_GRAM=6500
DEFAULT_SILVER_RATE_PER_GRAM=85
